      "icons": [{ "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mappa degli eventi",
      "short_name": "Mappa",
      "url": "/mappa.html?source=pwa-shortcut",
      "icons": [{ "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192" }]
    }
  ]
